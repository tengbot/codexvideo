{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/visual_match",
  "title": "Visual Match",
  "description": "Maps each story beat to scored source, stock, generated, or motion-graphics candidates.",
  "type": "object",
  "required": ["version", "format", "scenes"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "format": {"type": "string", "enum": ["faceless_narrative", "ai_dialogue_podcast"]},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "beat_ref", "visual_intent", "candidates", "selected_candidate_id"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "beat_ref": {"type": "string", "minLength": 1},
          "visual_intent": {"type": "string", "minLength": 1},
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/candidate"}
          },
          "selected_candidate_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["id", "type", "provider", "source", "scores"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["source_capture", "stock_video", "stock_image", "generated_video", "generated_image", "avatar", "motion_graphics"]},
        "provider": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"]},
        "local_path": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "scores": {
          "type": "object",
          "required": ["relevance", "composition", "motion", "brand_fit", "total"],
          "properties": {
            "relevance": {"type": "number", "minimum": 0, "maximum": 5},
            "composition": {"type": "number", "minimum": 0, "maximum": 5},
            "motion": {"type": "number", "minimum": 0, "maximum": 5},
            "brand_fit": {"type": "number", "minimum": 0, "maximum": 5},
            "total": {"type": "number", "minimum": 0, "maximum": 20}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
