{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/visual_continuity_bible",
  "title": "Visual Continuity Bible",
  "description": "Locks product identity and visual grammar across generated, captured, and composited scenes.",
  "type": "object",
  "required": ["version", "project_id", "provenance", "identity", "visual_system", "continuity_locks", "scenes", "dependencies"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["inspired_by", "repository", "commit", "license", "integration"],
      "properties": {
        "inspired_by": {"type": "string", "const": "OpenStory"},
        "repository": {"type": "string", "const": "https://github.com/openstory-so/openstory"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "const": "MIT"},
        "integration": {"type": "string", "const": "independent_contract_adaptation"}
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["subject", "brand_mark", "product_surfaces", "forbidden_substitutions"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "brand_mark": {"type": "string", "minLength": 1},
        "product_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden_substitutions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "visual_system": {
      "type": "object",
      "required": ["palette", "typography", "lighting", "camera", "motion"],
      "properties": {
        "palette": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "typography": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "lighting": {"type": "string", "minLength": 1},
        "camera": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "motion": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "texture": {"type": "string"}
      },
      "additionalProperties": false
    },
    "continuity_locks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scope", "rule", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "enum": ["global", "brand", "product", "scene_transition", "generated_asset"]},
          "rule": {"type": "string", "minLength": 1},
          "verification": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "inherits", "state", "entry_match", "exit_match"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "inherits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "state": {"type": "string", "minLength": 1},
          "entry_match": {"type": ["string", "null"]},
          "exit_match": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact", "content_hash", "invalidates"],
        "properties": {
          "artifact": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "invalidates": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
