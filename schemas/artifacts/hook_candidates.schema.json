{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/hook_candidates",
  "title": "Hook Candidates",
  "description": "Need-driven hook options scored before a faceless or dialogue script is approved.",
  "type": "object",
  "required": ["version", "topic", "audience", "candidates", "approval"],
  "properties": {
    "version": {"type": "string", "enum": ["1.0", "1.1"]},
    "topic": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 3
    },
    "selected_id": {"type": ["string", "null"]},
    "selected_ids": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "approved_with_changes", "rejected"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"version": {"const": "1.1"}},
        "required": ["version"]
      },
      "then": {
        "properties": {
          "candidates": {"items": {"$ref": "#/$defs/candidateV11"}}
        }
      },
      "else": {
        "properties": {
          "candidates": {"items": {"$ref": "#/$defs/candidateV1"}}
        }
      }
    }
  ],
  "$defs": {
    "candidateBase": {
      "type": "object",
      "required": ["id", "text", "human_need", "promise", "format_fits", "scores", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "text": {"type": "string", "minLength": 1},
        "pain_id": {"type": "string", "minLength": 1},
        "human_need": {"type": "string", "minLength": 1},
        "promise": {"type": "string", "minLength": 1},
        "hook_type": {
          "type": "string",
          "enum": ["direct_pain", "failed_alternative", "risk_loss", "before_after", "proof_led", "objection_dialogue", "desire_led", "contrarian"]
        },
        "spoken_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "first_frame": {"type": "string", "minLength": 1},
        "three_second_gate": {
          "type": "object",
          "required": ["passes", "pain_is_explicit", "brand_first", "visual_sync"],
          "properties": {
            "passes": {"type": "boolean"},
            "pain_is_explicit": {"type": "boolean"},
            "brand_first": {"type": "boolean"},
            "visual_sync": {"type": "boolean"},
            "credibility_supported": {"type": "boolean"},
            "body_payoff_matches": {"type": "boolean"},
            "speakability_passes": {"type": "boolean"},
            "notes": {"type": "string"}
          },
          "additionalProperties": false
        },
        "credibility": {
          "type": "object",
          "required": ["basis", "claim_scope", "source_refs"],
          "properties": {
            "basis": {
              "type": "string",
              "enum": ["product_truth", "consumer_language", "visible_demonstration", "measured_result", "qualified_claim"]
            },
            "claim_scope": {"type": "string", "minLength": 1},
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        },
        "body_payoff": {
          "type": "object",
          "required": ["promise", "payoff_beat", "matches"],
          "properties": {
            "promise": {"type": "string", "minLength": 1},
            "payoff_beat": {"type": "string", "enum": ["solution", "proof", "cta"]},
            "matches": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "speakability": {
          "type": "object",
          "required": ["language", "word_count", "duration_seconds", "duration_source", "passes"],
          "properties": {
            "language": {"type": "string", "minLength": 2},
            "word_count": {"type": "integer", "minimum": 1},
            "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
            "duration_source": {"type": "string", "enum": ["estimated", "tts_sample", "recorded_read"]},
            "passes": {"type": "boolean"},
            "notes": {"type": "string"}
          },
          "additionalProperties": false
        },
        "format_fits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["faceless_narrative", "screen_demo", "motion_graphics", "avatar_spokesperson", "ai_dialogue_podcast", "hybrid"]}
        },
        "scores": {
          "type": "object",
          "required": ["truth", "retention", "relevance", "total"],
          "properties": {
            "truth": {"type": "number", "minimum": 0, "maximum": 5},
            "retention": {"type": "number", "minimum": 0, "maximum": 5},
            "relevance": {"type": "number", "minimum": 0, "maximum": 5},
            "total": {"type": "number", "minimum": 0, "maximum": 15}
          },
          "additionalProperties": false
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "candidateV1": {
      "$ref": "#/$defs/candidateBase"
    },
    "candidateV11": {
      "allOf": [
        {"$ref": "#/$defs/candidateBase"},
        {"required": ["credibility", "body_payoff", "speakability"]}
      ]
    }
  },
  "additionalProperties": false
}
