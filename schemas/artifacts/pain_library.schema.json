{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/pain_library",
  "title": "Pain Library",
  "description": "A ranked inventory of 20 to 50 evidence-linked consumer pains for one product and audience.",
  "type": "object",
  "required": ["version", "product_id", "audience", "research_date", "pains", "ranking_method"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "product_id": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "research_date": {"type": "string", "format": "date"},
    "ranking_method": {"type": "string", "minLength": 1},
    "pains": {
      "type": "array",
      "minItems": 20,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/pain"}
    },
    "selected_pain_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "pain": {
      "type": "object",
      "required": ["id", "statement", "user_language", "persona", "situation", "job_to_be_done", "evidence_refs", "scores", "rank"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "statement": {"type": "string", "minLength": 1},
        "kind": {"enum": ["consumer_need", "product_defect", "production_blocker"], "default": "consumer_need"},
        "user_language": {"type": "string", "minLength": 1},
        "persona": {"type": "string", "minLength": 1},
        "situation": {"type": "string", "minLength": 1},
        "job_to_be_done": {"type": "string", "minLength": 1},
        "awareness_stage": {"type": "string", "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "scores": {
          "type": "object",
          "required": ["frequency", "urgency", "severity", "commercial_intent", "confidence", "total"],
          "properties": {
            "frequency": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
            "urgency": {"type": "number", "minimum": 0, "maximum": 5},
            "severity": {"type": "number", "minimum": 0, "maximum": 5},
            "commercial_intent": {"type": "number", "minimum": 0, "maximum": 5},
            "confidence": {"type": "number", "minimum": 0, "maximum": 5},
            "total": {"type": "number", "minimum": 0, "maximum": 25}
          },
          "additionalProperties": false
        },
        "rank": {"type": "integer", "minimum": 1, "maximum": 50}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
