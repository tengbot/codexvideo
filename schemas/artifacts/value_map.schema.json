{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/value_map",
  "title": "Pain to Value Map",
  "description": "Maps consumer pains to verified product claims, promises, proof, and calls to action.",
  "type": "object",
  "required": ["version", "product_id", "mappings"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "product_id": {"type": "string", "minLength": 1},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pain_id", "claim_ids", "promise", "solution", "proof_refs", "cta", "format_fits", "scores"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "pain_id": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "promise": {"type": "string", "minLength": 1},
          "solution": {"type": "string", "minLength": 1},
          "proof_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cta": {"type": "string", "minLength": 1},
          "format_fits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["faceless_narrative", "screen_demo", "motion_graphics", "avatar_spokesperson", "ai_dialogue_podcast", "hybrid"]}
          },
          "scores": {
            "type": "object",
            "required": ["pain_fit", "claim_truth", "proof_strength", "visual_potential", "total"],
            "properties": {
              "pain_fit": {"type": "number", "minimum": 0, "maximum": 5},
              "claim_truth": {"type": "number", "minimum": 0, "maximum": 5},
              "proof_strength": {"type": "number", "minimum": 0, "maximum": 5},
              "visual_potential": {"type": "number", "minimum": 0, "maximum": 5},
              "total": {"type": "number", "minimum": 0, "maximum": 20}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "selected_mapping_id": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
