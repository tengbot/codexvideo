{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/batch_run",
  "title": "Campaign Batch Run",
  "description": "Resumable execution state and media QA for a campaign batch.",
  "type": "object",
  "required": [
    "version",
    "campaign_id",
    "campaign_plan_path",
    "plan_hash",
    "jobs",
    "summary",
    "updated_at"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_plan_path": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "required": [
        "id",
        "variant_id",
        "profile_id",
        "module_ids",
        "input_hash",
        "output_path",
        "status",
        "attempts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "module_ids": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["planned", "running", "qa_passed", "failed"]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "type": ["string", "null"]
        },
        "qa": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["total", "planned", "running", "qa_passed", "failed"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "planned": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "qa_passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
