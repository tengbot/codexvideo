{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/production_preset",
  "title": "Production Preset",
  "description": "Approved, resumable production settings for deterministic single-video and campaign execution.",
  "type": "object",
  "required": ["version", "preset_id", "provenance", "approval", "runtime", "outputs", "batch", "stage_policies"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "preset_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "provenance": {
      "type": "object",
      "required": ["inspired_by", "repository", "commit", "license", "integration"],
      "properties": {
        "inspired_by": {"type": "string", "const": "MoneyPrinterTurbo"},
        "repository": {"type": "string", "const": "https://github.com/harry0703/MoneyPrinterTurbo"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "const": "MIT"},
        "integration": {"type": "string", "const": "independent_contract_adaptation"}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "approved_with_changes", "rejected"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["renderer_family", "render_runtime", "composition_mode"],
      "properties": {
        "renderer_family": {"type": ["string", "null"]},
        "render_runtime": {"type": ["string", "null"], "enum": ["remotion", "hyperframes", "ffmpeg", null]},
        "composition_mode": {"type": ["string", "null"], "enum": ["templated", "atelier", null]},
        "fallback_runtime": {"type": ["string", "null"], "enum": ["remotion", "hyperframes", "ffmpeg", null]}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "width", "height", "fps", "codec", "caption_mode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 320},
          "height": {"type": "integer", "minimum": 320},
          "fps": {"type": "integer", "minimum": 24, "maximum": 60},
          "codec": {"type": "string", "minLength": 1},
          "caption_mode": {"type": "string", "enum": ["burned", "sidecar", "both", "none"]},
          "cta_tail_seconds": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "language": {"type": "string", "minLength": 2},
        "voice_provider": {"type": ["string", "null"]},
        "voice_id": {"type": ["string", "null"]},
        "transcription": {"type": "string", "enum": ["provider_word_timing", "whisper", "forced_alignment", "none"]},
        "normalization_lufs": {"type": "number", "minimum": -30, "maximum": -5}
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "required": ["variant_axes", "max_changed_dimensions", "max_parallel_jobs", "cache_policy", "rerun_policy"],
      "properties": {
        "variant_axes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["hook", "body", "cta", "voice", "aspect", "caption_style"]}},
        "max_changed_dimensions": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_parallel_jobs": {"type": "integer", "minimum": 1, "maximum": 32},
        "cache_policy": {"type": "string", "const": "content_addressed"},
        "rerun_policy": {"type": "string", "const": "failed_or_stale_only"}
      },
      "additionalProperties": false
    },
    "stage_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "stale_when_inputs_change", "max_retries", "preserve_originals"],
        "properties": {
          "stage": {"type": "string", "minLength": 1},
          "stale_when_inputs_change": {"type": "boolean"},
          "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
          "preserve_originals": {"type": "boolean"},
          "cost_ceiling_usd": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
