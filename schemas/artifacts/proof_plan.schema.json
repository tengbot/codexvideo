{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/proof_plan",
  "title": "Promotion Proof Plan",
  "description": "Requires every persuasive beat to have a concrete, provenance-tracked visual proof.",
  "type": "object",
  "required": ["version", "creative_id", "scenes"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "creative_id": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "beat", "start_seconds", "end_seconds", "claim_refs", "visual_intent", "proof_type", "asset_requirement", "acceptance_criteria"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "beat": {"type": "string", "enum": ["hook", "pain", "solution", "proof", "offer", "cta"]},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "pain_ref": {"type": ["string", "null"]},
          "claim_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "visual_intent": {"type": "string", "minLength": 1},
          "proof_type": {"type": "string", "enum": ["product_capture", "output_comparison", "before_after", "first_party_claim", "external_context", "motion_explanation"]},
          "asset_requirement": {"type": "string", "minLength": 1},
          "selected_asset_ref": {"type": ["string", "null"]},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
