{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/shot_language_plan",
  "title": "Shot Language Plan",
  "description": "Maps approved proof scenes to traceable video-shotcraft recipes and frame-level execution constraints.",
  "type": "object",
  "required": ["version", "source", "format", "canvas", "scenes"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "source": {
      "type": "object",
      "required": ["repository", "commit", "license", "catalog_path"],
      "properties": {
        "repository": {"type": "string", "const": "https://github.com/Vincentwei1021/video-shotcraft"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "const": "Apache-2.0"},
        "catalog_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "format": {"type": "string", "enum": ["product_promo", "faceless_narrative", "ai_dialogue_podcast"]},
    "canvas": {
      "type": "object",
      "required": ["aspect", "width", "height", "fps"],
      "properties": {
        "aspect": {"type": "string", "enum": ["9:16", "1:1", "16:9"]},
        "width": {"type": "integer", "minimum": 320},
        "height": {"type": "integer", "minimum": 320},
        "fps": {"type": "integer", "minimum": 24, "maximum": 60}
      },
      "additionalProperties": false
    },
    "energy_curve": {
      "type": "array",
      "items": {"type": "string", "enum": ["low", "medium", "medium_high", "high", "rest"]}
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id", "beat", "start_seconds", "end_seconds", "shot_card",
          "style_key", "recipe_path", "implementation_files", "visual_intent",
          "primary_motion", "asset_requirements", "responsive_rules", "acceptance_frames"
        ],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "beat": {"type": "string", "minLength": 1},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "shot_card": {"type": "string", "minLength": 1},
          "style_key": {"type": "string", "minLength": 1},
          "recipe_path": {"type": "string", "minLength": 1},
          "implementation_files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "reference_media": {"type": ["string", "null"]},
          "visual_intent": {"type": "string", "minLength": 1},
          "primary_motion": {"type": "string", "minLength": 1},
          "transition_in": {"type": ["string", "null"]},
          "transition_out": {"type": ["string", "null"]},
          "sfx_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["frame", "action", "source_path"],
              "properties": {
                "frame": {"type": "integer", "minimum": 0},
                "action": {"type": "string", "minLength": 1},
                "source_path": {"type": "string", "minLength": 1},
                "gain": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "asset_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "responsive_rules": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "acceptance_frames": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "integer", "minimum": 0}
          },
          "adaptation_notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
